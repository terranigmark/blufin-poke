# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Production: the Koyeb host, e.g. blufin-api-xxxx.koyeb.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: the same host with https://, e.g. https://blufin-api-xxxx.koyeb.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Neon connection string. Leave unset locally to use backend/db.sqlite3.
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/blufin?sslmode=require
