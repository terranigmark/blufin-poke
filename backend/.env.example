# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Production: the Koyeb host, e.g. blufin-api-xxxx.koyeb.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: the same host with https://, e.g. https://blufin-api-xxxx.koyeb.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Extra origins allowed to call /api/ (blufinpoke.com and *.vercel.app are built in).
DJANGO_CORS_ALLOWED_ORIGINS=

# Neon connection string. Leave unset locally to use backend/db.sqlite3.
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/blufin?sslmode=require

# Password-reset emails through Resend (unset: printed to the console).
# RESEND_API_KEY=re_xxxx
# DEFAULT_FROM_EMAIL=Blufin Poke Co <no-reply@blufinpoke.com>
# SITE_URL=https://blufinpoke.com
